# Yönetim paneli yedekleri: virgülle ayrılmış yetkili e-postalar.
# Boş bırakılırsa yalnızca Netlify Identity üzerinde admin/editor rolü olan hesaplar erişebilir.
ADMIN_EMAILS=yonetici@ornek.com

# Finans geçidi: uygulamanın HTTPS adresi. Varsayılan/fallback adres yoktur.
FINANCE_APP_URL=https://finans-alan-adiniz.example

# Finans rolleri. Editör kayıtları görebilir ve değiştirebilir; görüntüleyici yalnızca okuyabilir.
FINANCE_EDITOR_EMAILS=yonetici@ornek.com
FINANCE_VIEWER_EMAILS=

# Netlify ile ayrı finans uygulaması arasında ortak, en az 32 karakterlik rastgele anahtar.
# Aynı değer finans uygulamasının ortam değişkenlerinde de tanımlanmalıdır.
FINANCE_ACCESS_SHARED_SECRET=EN_AZ_32_KARAKTER_RASTGELE_GIZLI_DEGER

# Finans uygulamasında doğrudan erişim reddedildiğinde dönülecek yönetim adresi.
FINANCE_LOGIN_URL=https://elciveteriner.com/finans/


# Work automation API. Do not place plaintext Work tokens in this file or the repository.
WORK_ADMIN_GITHUB_TOKEN=
WORK_ADMIN_TOKENS_JSON=[]
WORK_ADMIN_ALLOWED_ORIGINS=https://xn--eliveterinerklinii-8ub94i.com
WORK_ADMIN_REPOSITORY=elciadmin/veteriner-klinik-sitesi
WORK_ADMIN_BRANCH=main
WORK_ADMIN_RATE_LIMIT=60


# Elçi Yayın Merkezi — sosyal ağ bağlantıları.
# Secret değerleri yalnızca Netlify environment variables içinde saklayın.
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Google OAuth: aynı refresh token gerekli kapsamları içermelidir.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Google Business Profile API erişimi onaylandıktan sonra doldurulur.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Yayın Merkezi OAuth tokenlarını AES-256-GCM ile şifrelemek için 64 karakter hex secret.
# Bu değeri repoya yazmayın; yalnız Netlify secret olarak tanımlayın.
PUBLISHER_TOKEN_ENCRYPTION_KEY=
